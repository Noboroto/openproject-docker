<% html_title t(:"mfa_enforcement.blocked_title") %>
<%= render Primer::OpenProject::PageHeader.new do |header|
      header.with_title { t(:"mfa_enforcement.blocked_title") }
    end %>

<div class="op-toast -warning" role="alert">
  <div class="op-toast--content">
    <p><%= t(:"mfa_enforcement.blocked_body") %></p>
  </div>
</div>

<p>
  <%= link_to t(:"mfa_enforcement.set_up_now"),
              @setup_path,
              class: "button -highlight -with-icon icon-two-factor-authentication" %>
</p>

<p class="form--field-instructions">
  <%= t(:"mfa_enforcement.blocked_hint") %>
</p>
