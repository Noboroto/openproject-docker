<% subject_key = @kind == :due ? :"date_alerts.notification_due" : :"date_alerts.notification_start" %>
<%= t(subject_key, subject: @work_package.subject) %>

#<%= @work_package.id %> - <%= @work_package.subject %>
<% if @kind == :due && @work_package.respond_to?(:due_date) && @work_package.due_date %>
<%= t(:"date_alerts.lead_days") %>: <%= @work_package.due_date %>
<% elsif @work_package.respond_to?(:start_date) && @work_package.start_date %>
<%= t(:"date_alerts.lead_days") %>: <%= @work_package.start_date %>
<% end %>
