# frozen_string_literal: true

# OpenProject loads this file after its core Gemfile. Declare custom plugins here
# (via `path:`) plus any third-party gems those plugins genuinely need.
# These paths are baked into the custom image (Phase 3, Dockerfile.app) at
# /app/plugins/<dir>. Locally the dev container mounts ./plugins at /app/plugins.

# NOTE: SSO (SAML + OIDC) is ALREADY shipped in OpenProject Community as the
# bundled modules `openproject-auth_saml` (omniauth-saml) and
# `openproject-openid_connect` (omniauth_openid_connect). Our standalone
# `openproject-auth_sso` plugin is therefore redundant and re-declaring those
# omniauth gems conflicts with OP's pinned versions (boot crash). It is removed
# from the build. Configure SSO via OP's built-in Administration → Authentication.
# (Plugin source kept under plugins/openproject-auth-sso/ for reference only.)

# --- Tier 1 plugins ----------------------------------------------------------
gem "openproject-branding",        path: "plugins/openproject-branding"
gem "openproject-mfa_enforcement", path: "plugins/openproject-mfa-enforcement"
gem "openproject-action_boards",   path: "plugins/openproject-action-boards"
gem "openproject-time_reports",    path: "plugins/openproject-time-reports"
gem "openproject-dashboards_plus", path: "plugins/openproject-dashboards-plus"
gem "openproject-date_alerts",     path: "plugins/openproject-date-alerts"

# --- Tier 2 plugins ----------------------------------------------------------
gem "openproject-project_templates", path: "plugins/openproject-project-templates"
# Renamed from team_planner: core ships an (EE-gated) module with that exact gem
# name, so a CE-distinct name avoids the bundler/engine collision.
gem "openproject-teamplanner_ce",  path: "plugins/openproject-team-planner"
gem "openproject-ldap_group_sync", path: "plugins/openproject-ldap-group-sync"
gem "openproject-placeholder_users", path: "plugins/openproject-placeholder-users"
gem "openproject-email_digests",   path: "plugins/openproject-email-digests"
gem "openproject-custom_actions",  path: "plugins/openproject-custom-actions"
gem "openproject-audit_trail",     path: "plugins/openproject-audit-trail"
# Thin extension — CE already ships attribute help texts; this only adds tooltip CSS.
gem "openproject-attribute-help-texts", path: "plugins/openproject-attribute-help-texts"

# --- Tier 3 plugins (feature-flagged OFF by default) -------------------------
# Advanced CF types (multi-select, hierarchy, multi-user, multi-version).
gem "openproject-custom_fields_plus", path: "plugins/openproject-custom-fields-plus"
# Point-in-time project snapshots + diff against core journals (read-only).
gem "openproject-baselines",          path: "plugins/openproject-baselines"
# Tokenized public read-only links (unauthenticated path, security-sensitive).
gem "openproject-public_share",       path: "plugins/openproject-public-share"
# Styled PDF export templates (Prawn-based; SSTI-safe admin HTML sanitization).
gem "openproject-pdf_styler",         path: "plugins/openproject-pdf-styler"

# --- Companion: MCP server guide + health check ------------------------------
# Admin page that shows the op-mcp connection path and health-checks it.
# Settings-only (no DB table / no migration).
gem "openproject-mcp-ce",          path: "plugins/openproject-mcp-ce"
