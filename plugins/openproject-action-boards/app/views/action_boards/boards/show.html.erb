<%#
  Server-rendered action board with drag-drop columns + scoped styling.

  Drag-drop is driven by frontend/board_drag_controller.js. On drop it PATCHes
  project_action_board_move_card_path; the server applies the move through
  WorkPackages::UpdateService and returns 200 (stays) or 422 (reverts).

  WHERE ANGULAR WOULD GO: OpenProject core boards are Angular. A production-grade
  integration would register an Angular component via the OP frontend module
  system. This styled server-rendered version is the deliberate first iteration.
%>
<style>
  /* Page padding so content clears the project sidebar toggle / window edges
     (the project layout renders plugin views flush-left otherwise). */
  .op-ab { margin: 0; padding: 1.5rem 2rem; }
  .op-ab__head { display:flex; align-items:baseline; gap:.5rem; margin:0 0 1.25rem; padding-top:.25rem; }
  .op-ab__type { color:#6e7781; font-size:.875rem; }
  .op-ab__cols {
    display:flex; gap:1rem; align-items:flex-start;
    overflow-x:auto; padding-bottom:.75rem;
  }
  .op-ab__col {
    flex:0 0 300px; max-width:300px;
    background:#f6f8fa; border:1px solid #d0d7de; border-radius:8px;
    display:flex; flex-direction:column; max-height:72vh;
  }
  .op-ab__col-head {
    display:flex; align-items:center; justify-content:space-between;
    gap:.5rem; padding:.6rem .75rem; border-bottom:1px solid #d0d7de;
    position:sticky; top:0; background:#f6f8fa; border-radius:8px 8px 0 0;
  }
  .op-ab__col-title {
    margin:0; font-size:.875rem; font-weight:600; color:#24292f;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .op-ab__count {
    flex:0 0 auto; min-width:1.5rem; text-align:center;
    background:#eaeef2; color:#57606a; border-radius:999px;
    padding:.05rem .45rem; font-size:.75rem; font-weight:600;
  }
  .op-ab__cards { list-style:none; margin:0; padding:.5rem; overflow-y:auto; min-height:48px; }
  .op-ab__card {
    background:#fff; border:1px solid #d0d7de; border-radius:6px;
    padding:.5rem .6rem; margin:0 0 .5rem;
    box-shadow:0 1px 0 rgba(27,31,36,.04);
    cursor:grab; transition:box-shadow .12s, border-color .12s;
  }
  .op-ab__card:hover { border-color:#0969da; box-shadow:0 2px 6px rgba(27,31,36,.12); }
  .op-ab__card:last-child { margin-bottom:0; }
  .op-ab__card a {
    color:#24292f; text-decoration:none; font-size:.875rem; line-height:1.35;
    display:block; overflow-wrap:anywhere; word-break:break-word;
  }
  .op-ab__card a:hover { color:#0969da; text-decoration:underline; }
  .op-ab__empty { color:#8c959f; font-size:.8125rem; font-style:italic; padding:.5rem; }
  .op-ab__card.-dragging { opacity:.5; }
  .op-ab__cards.-dragover { background:#ddf4ff; border-radius:6px; }
</style>

<div class="op-ab" data-controller="board-drag"
     data-board-drag-move-url-template-value="<%= project_action_board_move_card_path(@project, board_id: @board.id) %>"
     data-board-drag-csrf-value="<%= form_authenticity_token %>">
  <%= render Primer::OpenProject::PageHeader.new do |header|
        header.with_title { @board.name }
        header.with_breadcrumbs(nil)
      end %>
  <div class="op-ab__head">
    <span class="op-ab__type"><%= t(:"action_boards.action_type.#{@board.action_type}") %></span>
  </div>

  <div class="op-ab__cols">
    <% @columns.each do |column| %>
      <% cards = Array(@cards_by_column[column]) %>
      <section class="op-ab__col" data-board-drag-target="column" data-column-id="<%= column.id %>">
        <header class="op-ab__col-head">
          <h3 class="op-ab__col-title" title="<%= column.title %>"><%= column.title %></h3>
          <span class="op-ab__count"><%= cards.size %></span>
        </header>
        <ul class="op-ab__cards" data-board-drag-target="dropzone" data-column-id="<%= column.id %>">
          <% cards.each do |wp| %>
            <li class="op-ab__card" draggable="true"
                data-board-drag-target="card" data-work-package-id="<%= wp.id %>">
              <%= link_to card_label(wp), work_package_path(wp), title: card_label(wp) %>
            </li>
          <% end %>
          <% if cards.empty? %>
            <li class="op-ab__empty"><%= t(:"action_boards.no_cards") %></li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>

<p style="margin-top:1rem;">
  <%= link_to t(:button_back), project_action_boards_path(@project), class: "button" %>
</p>
