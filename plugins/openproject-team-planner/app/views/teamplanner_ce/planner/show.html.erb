<%#
  Angular-based Team Planner CE.
  The <op-team-planner-ce> custom element is defined by the standalone Angular app
  compiled in Dockerfile.app and served from /teamplanner_ce/browser/main.js.
  The Angular component calls /projects/:id/teamplanner_ce/data (JSON) for FullCalendar data.
%>
<% html_title t(:"teamplanner_ce.title") %>
<%= render Primer::OpenProject::PageHeader.new do |header|
      header.with_title { t(:"teamplanner_ce.title") }
      header.with_breadcrumbs(nil)
    end %>

<%# Load Angular standalone bundle — mtime query string ensures browser picks up new builds %>
<% _tp_v = begin; File.mtime(Rails.root.join("public/teamplanner_ce/main.js")).to_i; rescue; 1; end %>
<script src="/teamplanner_ce/polyfills.js?v=<%= _tp_v %>" type="module"></script>
<script src="/teamplanner_ce/main.js?v=<%= _tp_v %>" type="module"></script>

<style>
  /* Custom element is inline by default — make it a block that fills the column */
  op-team-planner-ce { display: block; width: 100%; }
  .op-tp-ce-wrapper  { padding: 1rem 2rem 0; }
  .op-tp-ce-loading  { display: flex; justify-content: center; padding: 4rem; }
  .op-tp-ce-error    { margin: 1rem; }
  /* FullCalendar height: fill remaining viewport below the page header (~160px) */
  .op-tp-ce-wrapper .fc { height: calc(100vh - 200px); }
</style>

<op-team-planner-ce
  data-project-identifier="<%= @project.identifier %>"
  data-from="<%= @from.iso8601 %>"
  data-to="<%= @to.iso8601 %>">
</op-team-planner-ce>

<% if can_manage_teamplanner_ce_views?(@project) %>
  <div class="op-tp-saved-views" style="padding: 0 2rem 1rem;">
    <%= form_with url: project_save_teamplanner_ce_path(@project), method: :post, local: true do %>
      <%= hidden_field_tag :from, @from.iso8601 %>
      <%= hidden_field_tag :to, @to.iso8601 %>
      <div class="form--inline" style="display:flex;gap:.5rem;align-items:end;">
        <label class="form--label" style="margin:0;">
          <%= t(:"teamplanner_ce.view_name") %>
          <%= text_field_tag :name, nil, class: "form--text-field", style: "width:180px" %>
        </label>
        <%= submit_tag t(:"teamplanner_ce.actions.save_view"), class: "button -slim" %>
      </div>
    <% end %>

    <% if @saved_views.present? %>
      <ul class="op-tp-views-list" style="list-style:none;padding:.5rem 0;display:flex;gap:.5rem;flex-wrap:wrap;">
        <% @saved_views.each do |view| %>
          <li style="background:#f6f8fa;border:1px solid #d0d7de;border-radius:999px;padding:.15rem .75rem;font-size:.8125rem;">
            <%= link_to view.name,
                        project_teamplanner_ce_path(@project,
                                                    from: view.filters["from"],
                                                    to: view.filters["to"]) %>
            <%= button_to t(:"teamplanner_ce.actions.delete_view"),
                          project_teamplanner_ce_view_path(@project, view),
                          method: :delete,
                          form: { style: "display:inline" },
                          class: "button -text -slim",
                          data: { confirm: t(:"teamplanner_ce.delete_confirm") } %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
