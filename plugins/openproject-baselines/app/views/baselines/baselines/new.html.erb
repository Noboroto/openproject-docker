<% html_title t("baselines.new") %>

<h2><%= t("baselines.new") %></h2>

<%= form_with model: @baseline, url: baselines_path(@project), scope: :baseline do |f| %>
  <%= error_messages_for :baseline %>

  <div class="form--field">
    <%= f.label :name, t("baselines.name_label"), class: "form--label" %>
    <div class="form--field-container">
      <%= f.text_field :name, class: "form--text-field" %>
    </div>
  </div>

  <div class="form--field">
    <%= f.label :captured_at, t("baselines.captured_at"), class: "form--label" %>
    <div class="form--field-container">
      <%= f.datetime_local_field :captured_at, class: "form--text-field" %>
    </div>
  </div>

  <div class="form--actions">
    <%= f.submit t("button_create"), class: "button -highlight" %>
    <%= link_to t("button_cancel"), baselines_path(@project), class: "button" %>
  </div>
<% end %>
