<%# Budget list with spent / remaining / percent-used progress bars. %>
<% html_title t(:"budget.title") %>
<%= render(Primer::OpenProject::PageHeader.new) do |header|
      header.with_title { t(:"budget.title") }
      header.with_breadcrumbs(nil)
    end %>

<p><%= link_to t(:"budget.new"), new_project_time_reports_budget_path(@project) %></p>

<table class="generic-table">
  <thead>
    <tr>
      <th><%= t(:"budget.name") %></th>
      <th><%= t(:"budget.amount") %></th>
      <th><%= t(:"budget.spent") %></th>
      <th><%= t(:"budget.remaining") %></th>
      <th><%= t(:"budget.percent_used") %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @budgets.each do |budget| %>
      <% summary = @summaries[budget] %>
      <tr>
        <td><%= budget.name %></td>
        <td><%= number_to_currency(budget.amount, unit: budget.currency + " ") %></td>
        <td><%= number_to_currency(summary.spent, unit: budget.currency + " ") %></td>
        <td class="<%= "op-budget--over" if summary.over_budget? %>">
          <%= number_to_currency(summary.remaining, unit: budget.currency + " ") %>
          <% if summary.over_budget? %>
            <span><%= t(:"budget.over_budget") %></span>
          <% end %>
        </td>
        <td>
          <progress value="<%= [summary.percent_used, 100].min %>" max="100"></progress>
          <%= summary.percent_used %>%
        </td>
        <td>
          <%= link_to t(:"budget.edit"), edit_project_time_reports_budget_path(@project, budget) %>
          <%= link_to t(:"budget.delete"), project_time_reports_budget_path(@project, budget),
                      method: :delete, data: { confirm: t(:"budget.delete_confirm") } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
